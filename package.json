{
  "name": "dsh-claude-move",
  "description": "Copy Claude Code transcripts, memories, skills and CLAUDE.md into DeepSeek Harness as resumable sessions — one workspace per project, copy-only, seamlessly resumable",
  "version": "0.2.0",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/PerryLink/dsh-claude-move#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-claude-move.git"
  },
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-claude-move/issues"
  },
  "files": [
    "index.mjs",
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.es.md",
    "README.pt.md",
    "README.hi.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "claude-code",
    "migration",
    "session-import",
    "resume"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0"
}
